# Neon Postgres. The pooled host contains "-pooler"; the direct one does not.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Shared league password: gates entering picks and all admin actions.
ADMIN_PASSWORD="changeme"

# Authenticates the automated GitHub Actions spread-sync. Generate with
# `openssl rand -hex 32`; must also be set as a CRON_SECRET repo secret
# in GitHub (Settings -> Secrets and variables -> Actions).
CRON_SECRET="changeme"
