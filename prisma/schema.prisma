generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for app queries; serverless opens one per invocation.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — prisma migrate can't run through pgbouncer.
  directUrl = env("DIRECT_URL")
}

model Player {
  id       String      @id @default(cuid())
  name     String      @unique
  picks    DraftPick[]
  flipWins Week[]      @relation("FlipWinner")
}

model Week {
  id     String     @id @default(cuid())
  season Int
  number Int
  status WeekStatus @default(PENDING)

  flipWinnerId String?
  flipWinner   Player? @relation("FlipWinner", fields: [flipWinnerId], references: [id])
  flippedAt    DateTime?

  // Timestamp of this week's first slate sync — informational only. Each
  // Game freezes its own spread individually at its own kickoff, not all
  // together at this moment.
  spreadsFrozenAt DateTime?

  games Game[]
  picks DraftPick[]

  @@unique([season, number])
}

model Game {
  id           String @id @default(cuid())
  weekId       String
  espnEventId  String @unique

  homeTeam String
  awayTeam String
  homeAbbr String
  awayAbbr String
  kickoff  DateTime

  // Always the HOME team's line: negative means home is favored.
  // Stays live on every re-sync until kickoff, then freezes for good —
  // ESPN drops odds once a game goes final, so a line not captured by
  // kickoff can never be recovered.
  homeSpread     Float?
  spreadFrozenAt DateTime?

  homeScore Int?
  awayScore Int?
  completed Boolean @default(false)

  week  Week        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  picks DraftPick[]

  @@index([weekId])
}

model DraftPick {
  id         String      @id @default(cuid())
  weekId     String
  playerId   String
  gameId     String
  pickNumber Int
  side       Side
  result     PickResult?
  createdAt  DateTime    @default(now())

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // One pick per game, period — once either side is drafted, the whole
  // matchup is gone (the opposite side is not a separate available pick).
  @@unique([gameId])
  @@unique([weekId, pickNumber])
  @@index([weekId])
}

enum Side {
  HOME
  AWAY
}

enum PickResult {
  WIN
  LOSS
  PUSH
}

enum WeekStatus {
  PENDING
  SLATE_LOADED
  DRAFTING
  COMPLETE
  GRADED
}
